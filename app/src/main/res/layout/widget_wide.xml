            android:format24Hour="HH:mm"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#FFC8D2DE"
            android:shadowRadius="14"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />
