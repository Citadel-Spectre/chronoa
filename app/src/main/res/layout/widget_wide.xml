<?xml version="1.0" encoding="utf-8"?>
<!--
    The wide (2x1) widget. Idle: one big clock. While a timer or alarm counts down: the time on
    the left, a line in the theme's color, and the countdown on the right. As in widget_timer.xml
    there is a copy of each part per color theme (index into Theme.ALL) since a widget can't set a
    glow from code, and only the chosen theme's are shown.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_fg"
        android:visibility="gone" />

