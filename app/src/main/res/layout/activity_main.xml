<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">
        <!-- Just the cog up here; the tabs are along the bottom. -->

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warn"
        android:padding="16dp"
        android:textColor="#FF000000"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/stopwatch_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Takes the place of the alarm list while setting an alarm's time. -->
    <FrameLayout
        android:id="@+id/alarm_entry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alarm_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ListView
            android:id="@+id/alarm_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/no_alarms"
            android:visibility="gone" />

        <Button
            android:id="@+id/add_alarm"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="16dp"
            android:contentDescription="@string/add_alarm"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timer_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pickers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/timer_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/text"
                android:textSize="56sp" />

            <FrameLayout
                android:id="@+id/timer_keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text"
            android:textSize="72sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/reset"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:text="@string/reset" />

            <Button
                android:id="@+id/start"
                android:layout_width="140dp"
                android:layout_height="64dp"
                android:text="@string/start" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider between the content and the tab bar: a dark groove with a faint blue light line. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF000000" />

    <View
        android:layout_width="match_parent"
        android:id="@+id/glow_line"
        android:layout_height="1dp"
        android:background="#552196F3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_stopwatch"
            style="@style/Tab"
            android:text="@string/stopwatch" />

        <TextView
            android:id="@+id/tab_alarm"
            style="@style/Tab"
            android:text="@string/alarm" />

        <TextView
            android:id="@+id/tab_timer"
            style="@style/Tab"
            android:text="@string/timer" />
    </LinearLayout>
</LinearLayout>
