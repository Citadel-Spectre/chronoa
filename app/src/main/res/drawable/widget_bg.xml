<?xml version="1.0" encoding="utf-8"?>
<!-- The timer widget's black face with a faint rim, like the ring screen's clock window. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:angle="270"
        android:endColor="#FF0E1218"
        android:startColor="#FF000000" />
    <stroke
        android:width="1.5dp"
        android:color="#FF3A3D44" />
</shape>
